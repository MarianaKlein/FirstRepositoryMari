# Copie este arquivo para .env.local (desenvolvimento) ou cadastre as
# mesmas variáveis em Vercel > Project > Settings > Environment Variables.

# Chaves de API (cobradas à parte das assinaturas de chat)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Senha única compartilhada com o time. Sem ela o app não responde,
# para ninguém de fora gastar o crédito das chaves.
APP_PASSWORD=

# Opcional: troque os modelos sem mexer no código.
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-4o
